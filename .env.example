# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored; this example file is not, so keep real secrets out of it.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string, used by the Next route handlers, the standalone
# Express server and the migration script.
# Note the port: a default install is 5432, but a second instance alongside an
# existing one commonly lands on 5433.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5433/yosenamora

# Set to "require" for a managed provider (Neon, Supabase, RDS) that refuses
# plaintext connections. Leave unset for a local server.
# PGSSL=require

# Max pooled connections. Lower this on a serverless host.
# PGPOOL_MAX=10

# --- Authentication (Clerk) -------------------------------------------------
# Clerk owns sign-in, sign-up and sessions. Get these from
# https://dashboard.clerk.com/~/api-keys, or run `clerk env pull`.
# The publishable key is safe to expose to the browser; the secret key is not
# and must never appear in client code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Signing secret for the Clerk account webhook (/api/webhooks/clerk), which
# captures accounts created outside the app. Copy it from the endpoint you add
# under Configure > Webhooks in the Clerk Dashboard. Without it the endpoint
# rejects every request rather than trusting an unsigned one.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_signing_secret_here

# Where Clerk's components live and where to land after authenticating.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# @clerk/express reads CLERK_PUBLISHABLE_KEY rather than the NEXT_PUBLIC_ name.
# backend/loadEnv.ts mirrors the value automatically, so setting it here is
# only needed if you run the Express server without that loader.
# CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# --- Concierge chat ---------------------------------------------------------
# Google Gemini key for src/app/api/chat/route.ts. The chat widget is disabled
# without it; the rest of the site runs fine.
# GEMINI_API_KEY=
