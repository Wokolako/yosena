# Copy to .env.local and fill in. Never commit real values.

# GEMINI_API_KEY: Required for the AI concierge.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WhatsApp trade desk: the number in src/lib/contact.ts is a placeholder — replace it with
# the real desk line. It is used by the concierge hand-off button.

# APP_URL: Public URL of the site (used for payment return links), e.g. https://www.example.com
APP_URL="MY_APP_URL"

# JWT_SECRET: REQUIRED in production. Signs session cookies. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start sessions in production without it.
JWT_SECRET=""

# DATA_DIR: Optional. Where the JSON data store lives (default: backend/data). Must be a
# persistent disk — on serverless hosting use a real database instead.
# DATA_DIR=""

# --- Payments -----------------------------------------------------------------
# Online payment (Stripe Checkout) is switched on only when both keys are set.
# Stripe must first approve the business: "high-value goods, precious metals and stones"
# is a restricted category that needs their due diligence.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."   # from the webhook endpoint for /api/webhooks/stripe

# Largest order that may be paid online (USD). Stripe caps non-card payments at 999,999.99.
# CARD_PAYMENT_LIMIT_USD=999999
# Online payment for approved trade accounts only (default true).
# CARD_REQUIRES_APPROVED_ACCOUNT=true

# Bank details shown to buyers who choose wire transfer (use \n for new lines).
# WIRE_BANK_DETAILS="Bank: ...\nIBAN: ...\nSWIFT: ..."

# How long stones stay reserved while the buyer pays.
# CARD_HOLD_MINUTES=45
# WIRE_HOLD_HOURS=72
# MEMO_HOLD_HOURS=72

# Tax rate applied at checkout (0.05 = 5%). Set it for your jurisdiction, or 0.
# TAX_RATE=0.05

# Trade discount codes, CODE:percent pairs. None are active unless set.
# PROMO_CODES="TRADE10:10"
